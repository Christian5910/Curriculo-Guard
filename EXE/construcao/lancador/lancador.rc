      VALUE "ProductName", "Currículo Guard"
      VALUE "FileDescription", "Currículo Guard"
      VALUE "FileVersion", "2.11"
      VALUE "ProductVersion", "2.11"
      VALUE "OriginalFilename", "CurriculoGuard.exe"
      VALUE "InternalName", "CurriculoGuard"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
